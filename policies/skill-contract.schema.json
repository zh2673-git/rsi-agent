{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rsi-agent/skill-contract.schema.json",
  "title": "skill.json（技能契约）",
  "type": "object",
  "required": ["name", "version", "status", "description", "acceptance", "verification"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["draft", "candidate", "active", "retired"] },
    "description": { "type": "string", "minLength": 8, "maxLength": 200 },
    "triggers": { "type": "array", "items": { "type": "string" } },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "criterion", "check"],
        "properties": {
          "id": { "type": "string" },
          "criterion": { "type": "string", "minLength": 4 },
          "check": { "enum": ["assert", "rubric", "judge", "human", "test"] }
        }
      }
    },
    "requires": { "type": "array", "items": { "type": "string" } },
    "handoff": { "type": "array", "items": { "type": "string" } },
    "verification": { "enum": ["verified", "partial", "unverified"] },
    "source_level": { "type": "string" },
    "created_at": { "type": "string" },
    "parent": { "type": ["string", "null"] },
    "legacy": { "type": "boolean" },
    "source": { "type": "object" }
  },
  "additionalProperties": true
}
