__pycache__/
*.pyc

# runtime 快照的构建与运行期产物
runtime/target/
runtime/target-selfupdate/
runtime/.stream/
runtime/.instances/
runtime/outputs/
runtime/plugins/memory/data/
node_modules/
config.json
config.magpie.local.json
*.log

# 中间物（探针/一次性分析脚本）：只留痕不入库
.scratch/

# 任务看板（本机状态，不是发行资产；由 scripts/board.py 与 /api/board 运行时生成）
.rsi/

# 补丁回滚备份（scripts/apply-tool-patches.py / apply-q-round.py 自动生成）
*.patchbak
*.qpatchbak
# Q 轮隔离构建目录（运行中 host 锁住 debug/*.exe 时使用）
runtime/target-q/
# D 轮隔离构建目录（同上）
runtime/target-d/
# RSI 基线构建缓存（cargo target，实测 913MB / 1765 文件，非源码）
runtime/target-base/


# Magpie 账号台账（含邮箱等 PII，仅本机）
config/magpie-accounts.json

# magpie 分析工作区（上游源码副本，不入库）
magpie/
config/*.bak

# 内容分发执行体：上游 social-auto-upload 的本地安装
# venv 262MB + 各平台登录态 cookie，都不入库；装法见 skills/content-publish/SKILL.md §5
# run.cmd 与 host 的 sau_on_path() 都按 tools/sau 这个固定路径探测
tools/
